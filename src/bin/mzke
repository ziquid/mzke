#!/usr/bin/env zsh

# mzke -- ZDS make wrapper

MZKE_VERSION=0.1.1-20260410
MZKE_ROOT=/usr/local/share/mzke

[[ "$1" == --version || "$1" == -v ]] && echo mzke version $MZKE_VERSION && make --version && exit 0

_mzke_find_mzkefile() {
  local STARTDIR MAKEFILE NUMSLASHES

  STARTDIR=$(pwd -P)
  cd "$STARTDIR" || return 1

  while true; do
    NUMSLASHES=$(pwd -P | tr -d -c / | wc -c)
    [[ "$NUMSLASHES" -le 2 ]] && break

    cd .. || return 1
    [[ -r Mzkefile ]] && MAKEFILE="$(pwd -P)/Mzkefile" && break
  done

  cd "$STARTDIR" || return 1
  print -r -- "$MAKEFILE"
}

_mzke_build_make_cmd() {
  make_cmd=(make -f "$MAKEFILE")
  [[ -n "$DIRNAME" ]] && make_cmd+=(-C "$DIRNAME")

  make_cmd+=("${make_opts[@]}")
  make_cmd+=(
    IS_MZKE=YES
    MAKE_USER_COMMAND=mzke
  )

  [[ -n "$ARGS_VALUE" ]] && make_cmd+=("ARGS=$ARGS_VALUE")
  make_cmd+=("$TARGET")
}

# Process -C flag first, before any file searching
if [[ "$1" == -C ]]; then
  cd "$2"
  [[ $? -ne 0 ]] && echo Error: could not cd to $2 >&2 && exit 1
  shift 2
fi

if [[ "$1" == -f ]]; then
  MAKEFILE="$2"
  shift 2
elif [[ -r Mzkefile ]]; then
  MAKEFILE=Mzkefile
elif [[ -r Makefile ]]; then
  MAKEFILE=Makefile
else
  # Search parent directories if no local M.kefile found
  MAKEFILE=$(_mzke_find_mzkefile)
  if [[ -n "$MAKEFILE" ]]; then
    DIRNAME=$(dirname "$MAKEFILE")
    MAKEFILE=$(basename "$MAKEFILE")
  fi
fi

[[ "$1" == --check-m?kefile ]] && exit $([[ -f "$MAKEFILE" ]] ; echo $?)

typeset -a make_cmd
typeset -a make_opts

[[ "$1" == -n ]] && make_opts+=(-n) && shift
[[ "$1" == -s ]] && make_opts+=(-s) && NO_PRINT_BANNER=1 && shift

TARGET=all
[[ -n "$1" ]] && TARGET="$1" && shift

ARGS_VALUE="$*"

# Rule 1: if no makefile and target is "prep", use Makefile
# Makefile.song.common

[[ "$TARGET" == prep && -z "$MAKEFILE" ]] && \
  MAKEFILE=/usr/local/share/muziq/Makefile.song.common

[[ -z "$MAKEFILE" && -n "$TARGET" && -f "$MZKE_ROOT/templates/Mzkefile.$TARGET.mk" ]] && MAKEFILE="$MZKE_ROOT/templates/Mzkefile.$TARGET.mk" && USING_TEMPLATE=Y

[[ -z "$MAKEFILE" ]] && echo Fatal error: No M.kefile found >&2 && exit 1

_mzke_build_make_cmd

# Execute make
[[ "$NO_PRINT_BANNER" == 1 ]] || print -r -- "${(qq)make_cmd}"
"${make_cmd[@]}"
err_num=$?

# non-template make failed but there is a template?  try that.
if [[ "$USING_TEMPLATE" != Y && "$err_num" -eq 2 && -n "$TARGET" && -f "$MZKE_ROOT/templates/Mzkefile.$TARGET.mk" ]]; then
  MAKEFILE="$MZKE_ROOT/templates/Mzkefile.$TARGET.mk"
  _mzke_build_make_cmd
  [[ "$NO_PRINT_BANNER" == 1 ]] || print -r -- "${(qq)make_cmd}"
  "${make_cmd[@]}"
  err_num=$?
fi

exit $err_num
